; Engine configuration file.
; 2026 武术擂台轮式对抗模拟器 — Godot 4 .NET 桌面端
; 注意: 本项目为脚手架，需安装 Godot 4 .NET (Mono) 后才能打开/编译。
; 仿真权威在 Sim.Core；本客户端只消费快照并发出裁判指令，不复刻规则。

config_version=5

[application]

config/name="WushuRingSim"
config/description="2026 RoboCup 武术擂台轮式对抗 — 确定性仿真桌面端"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "C#", "Forward Plus")

[dotnet]

project/assembly_name="GodotSim"

[input]

pause_toggle={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":80,"key_label":0,"unicode":112,"location":0,"echo":false,"script":null)
]
}
restart_us={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":114,"location":0,"echo":false,"script":null)
]
}
