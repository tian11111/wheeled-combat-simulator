<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- EchoController 是嵌套的独立 fixture 工程: 其源码/obj 不参与本测试工程编译。 -->
    <Compile Remove="EchoController/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sim.Core\Sim.Core.csproj" />
    <ProjectReference Include="..\Sim.Protocol\Sim.Protocol.csproj" />
    <ProjectReference Include="..\Sim.Cli\Sim.Cli.csproj" />
    <ProjectReference Include="..\Sim.Calibration\Sim.Calibration.csproj" />
    <!-- 最小 JSONL stdio 控制器 fixture (echo/wrongid/bad/die/hang), 供 batch 桥隔离测试。 -->
    <ProjectReference Include="EchoController\EchoController.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Godot 壳里无 Godot 依赖的适配器/会话/校验: 链接进来即可在无 Godot 环境回归。 -->
    <Compile Include="..\..\godot\src\SnapshotView.cs" Link="godot\SnapshotView.cs" />
    <Compile Include="..\..\godot\src\MatchSession.cs" Link="godot\MatchSession.cs" />
    <Compile Include="..\..\godot\src\ParityCheck.cs" Link="godot\ParityCheck.cs" />
    <Compile Include="..\..\godot\src\LayoutDraft.cs" Link="godot\LayoutDraft.cs" />
    <Compile Include="..\..\godot\src\FieldGrayTextureMap.cs" Link="godot\FieldGrayTextureMap.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
